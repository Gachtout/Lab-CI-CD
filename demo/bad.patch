diff --git a/app/Dockerfile b/app/Dockerfile
index 2e8ee0f..a4abd13 100644
--- a/app/Dockerfile
+++ b/app/Dockerfile
@@ -1,29 +1,12 @@
-# Image de base épinglée par digest : le tag indique la version, le digest garantit le contenu.
-FROM public.ecr.aws/docker/library/python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90
-
-ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
-
-# Le digest fige aussi les failles connues de l'image de base : on applique les
-# correctifs de sécurité publiés depuis sa construction.
-RUN apt-get update \
- && apt-get upgrade -y --no-install-recommends \
- && rm -rf /var/lib/apt/lists/*
+# DEMO : image de base en fin de vie, tag mobile sans digest, exécution en root.
+FROM python:3.7-slim
 
 WORKDIR /app
 
 COPY requirements.txt .
-# pip ne sert qu'à l'installation : on le retire ensuite, avec les bibliothèques qu'il embarque.
-RUN pip install --no-cache-dir -r requirements.txt \
- && pip uninstall --yes pip
+RUN pip install -r requirements.txt
 
 COPY app.py .
 
-# Utilisateur non privilégié, identifiant numérique fixe
-RUN useradd --system --uid 10001 --no-create-home appuser
-USER 10001
-
 EXPOSE 8000
-HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
-  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')"]
-
-CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "2", "app:app"]
+CMD ["gunicorn", "--bind", "0.0.0.0:8000", "app:app"]
diff --git a/app/app.py b/app/app.py
index 65d6a19..cbe3e89 100644
--- a/app/app.py
+++ b/app/app.py
@@ -30,8 +30,9 @@ def init_db():
 
 def create_app():
     app = Flask(__name__)
-    # Le jeton vient de l'environnement : jamais de secret dans le code.
-    app.config["API_TOKEN"] = os.environ.get("API_TOKEN", "")
+    # DEMO : secret de configuration et mode debug en dur.
+    app.config["API_TOKEN"] = "jeton-en-dur-a-remplacer"
+    app.config["DEBUG"] = True
     init_db()
 
     @app.get("/health")
@@ -42,8 +43,8 @@ def create_app():
     def users():
         name = request.args.get("name", "")
         con = get_db()
-        # Requête paramétrée : l'entrée utilisateur n'est jamais concaténée au SQL.
-        rows = con.execute("SELECT id, name, role FROM users WHERE name = ?", (name,)).fetchall()
+        # DEMO : entrée utilisateur concaténée au SQL (injection).
+        rows = con.execute("SELECT id, name, role FROM users WHERE name = '%s'" % name).fetchall()
         con.close()
         return jsonify(result=[dict(r) for r in rows])
 
